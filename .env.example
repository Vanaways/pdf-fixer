# All variables are optional; the values below are the defaults.

# Port the HTTP server listens on
PORT=3000

# Maximum upload size in MB
MAX_UPLOAD_MB=50

# Ghostscript timeout per conversion, in milliseconds
GS_TIMEOUT_MS=120000

# Ghostscript jobs allowed at once; extra requests get 503
MAX_CONCURRENT_JOBS=2

# Per-IP rate limit on POST /convert
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60

# Express "trust proxy" setting: number of proxy hops (1 behind Coolify's
# proxy), "false", or a subnet/keyword such as "loopback"
TRUST_PROXY=1
